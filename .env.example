# ==========================================
# VoiceBridge AI - Environment Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/voicebridge.log

# Pipeline Configuration Path
VOICEBRIDGE_CONFIG=config.yaml

# Security & API Authentication (Optional token auth)
# VOICEBRIDGE_API_KEY=your_secret_api_key_here
VOICEBRIDGE_ENABLE_AUTH=false
VOICEBRIDGE_RATE_LIMIT_PER_MINUTE=60

# Model Settings & Overrides
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
TTS_VOICE=en-US-AvaNeural

# Feature Flag Overrides
VOICEBRIDGE_ENABLE_PIPELINE_CONTRACTS=true
VOICEBRIDGE_ENABLE_NEW_INTERFACES=true
VOICEBRIDGE_ENABLE_TRACING=true
VOICEBRIDGE_ENABLE_STREAMING=true
VOICEBRIDGE_ENABLE_ASYNC_PIPELINE=true
VOICEBRIDGE_ENABLE_BACKPRESSURE=true
VOICEBRIDGE_ENABLE_MODEL_WARMUP=true
VOICEBRIDGE_ENABLE_INTELLIGENT_ROUTING=true
VOICEBRIDGE_ENABLE_FALLBACK_CHAINS=true
VOICEBRIDGE_ENABLE_CIRCUIT_BREAKER=true
VOICEBRIDGE_ENABLE_RATE_LIMITING=true
